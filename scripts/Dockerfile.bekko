FROM docker.io/library/python:3.12-slim-bookworm

WORKDIR /app

# Install torch CPU + sentence-transformers + transformers
RUN pip install --no-cache-dir \
    torch==2.10.0 \
    --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir \
    sentence-transformers==6.1.0 \
    transformers==5.17.0 \
    numpy

# Set environment
ENV PYTHONPATH=/app/model
ENV TRANSFORMERS_OFFLINE=1
ENV HF_HUB_OFFLINE=1

# Default: run inference test (model mounted at runtime)
CMD ["python3", "-c", "from inference_v0 import BekkoSentenceTransformer; m = BekkoSentenceTransformer('/app/model', device='cpu', trust_remote_code=True); print('MODEL_LOADED')"]
